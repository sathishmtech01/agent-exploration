# Copy to .env and fill in your key for the chosen provider.

# ── Provider selection ──────────────────────────────────────────────────────
# Options: gemini | openai | groq   (default: gemini)
LLM_PROVIDER=openai

# ── API Keys ────────────────────────────────────────────────────────────────
# Set ONLY the key for the provider you selected above.

OPENAI_API_KEY=sk-...

GROQ_API_KEY=gsk_...

GOOGLE_API_KEY=AIza...

# ── Model overrides (optional — defaults shown) ─────────────────────────────
# gemini  → gemini-2.0-flash
# openai  → gpt-4o-mini
# groq    → llama-3.3-70b-versatile
